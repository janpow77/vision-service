# vision-service ENV-Vorlage
# Pfad fuer Produktiv-Deploy: /etc/vision-service/env (chmod 600)

# Image-Tag (vom GHCR-Push)
IMAGE_TAG=v0.1

# Listen — Default ist 0.0.0.0 (alle Interfaces). Auf NUC mit Tailscale auf
# die Tailscale-IP einschraenken, damit der Service NUR ueber das Tailnet
# erreichbar ist:
#   VISION_BIND=100.102.132.11
VISION_BIND=0.0.0.0

# Device — auto | cpu | cuda | cuda:0
# 'auto' nimmt cuda wenn verfuegbar, sonst cpu (z.B. fuer evo-x2 mit RTX).
VISION_DEVICE=auto

# Donut-Modell (Default-Vision-Modell). Wird in /v1/models als 'donut-cord-v2'
# beworben, aber kann hier durch ein anderes Donut-Checkpoint ersetzt werden.
VISION_DONUT_MODEL=naver-clova-ix/donut-base-finetuned-cord-v2

# Backends aktivieren/deaktivieren
VISION_ENABLE_DONUT=true
VISION_ENABLE_TESSERACT=true
VISION_ENABLE_EASYOCR=false
VISION_ENABLE_CHANDRA=false

# Tesseract-Sprachen (kommagetrennt → tesseract-Syntax 'deu+eng')
VISION_TESSERACT_LANGS=deu,eng

# Standard-OCR-Backend bei /v1/ocr?backend=auto
VISION_OCR_DEFAULT_BACKEND=tesseract

# Limits
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_PDF_PAGES=50

# API-Key fuer Service-Auth. Empfohlen: vom llm-router gesetzt + im
# Spoke-Header (auth_value) konfiguriert. Leer = offen im Tailnet.
VISION_API_KEY=CHANGEME-vom-vault
